{
  "configuration": {
    "name": "Standard Office VLAN Setup",
    "description": "Standard VLAN configuration for office networks",
    "version": "1.0.0",
    "created_by": "Network Engineering Team"
  },
  "vlans": [
    {
      "id": 10,
      "name": "Management",
      "description": "Management VLAN for network devices",
      "subnet": "192.168.10.0/24",
      "gateway": "192.168.10.1",
      "dhcp_pool": {
        "start": "192.168.10.100",
        "end": "192.168.10.200"
      }
    },
    {
      "id": 20,
      "name": "Users",
      "description": "User workstation VLAN",
      "subnet": "192.168.20.0/24",
      "gateway": "192.168.20.1",
      "dhcp_pool": {
        "start": "192.168.20.100",
        "end": "192.168.20.250"
      }
    },
    {
      "id": 30,
      "name": "Servers",
      "description": "Server VLAN for internal services",
      "subnet": "192.168.30.0/24",
      "gateway": "192.168.30.1",
      "dhcp_pool": {
        "start": "192.168.30.100",
        "end": "192.168.30.150"
      }
    },
    {
      "id": 40,
      "name": "Guest",
      "description": "Guest network VLAN",
      "subnet": "10.10.40.0/24",
      "gateway": "10.10.40.1",
      "dhcp_pool": {
        "start": "10.10.40.100",
        "end": "10.10.40.200"
      }
    }
  ],
  "interfaces": {
    "GigabitEthernet0/1": {
      "description": "User Workstation Port",
      "switchport": "access",
      "vlan": 20,
      "spanning_tree": {
        "portfast": true,
        "bpduguard": true
      }
    },
    "GigabitEthernet0/2": {
      "description": "Server Connection",
      "switchport": "access",
      "vlan": 30,
      "spanning_tree": {
        "portfast": true
      }
    },
    "GigabitEthernet0/23": {
      "description": "Management Port",
      "switchport": "access",
      "vlan": 10,
      "spanning_tree": {
        "portfast": true,
        "bpduguard": true
      }
    },
    "GigabitEthernet0/24": {
      "description": "Trunk to Distribution Switch",
      "switchport": "trunk",
      "allowed_vlans": "10,20,30,40",
      "native_vlan": 1,
      "spanning_tree": {
        "priority": 32
      }
    }
  },
  "spanning_tree": {
    "mode": "rapid-pvst",
    "vlan_priorities": {
      "10": 4096,
      "20": 8192,
      "30": 12288,
      "40": 16384
    }
  },
  "security": {
    "port_security": {
      "enabled": true,
      "max_mac_addresses": 2,
      "violation_action": "shutdown"
    },
    "dhcp_snooping": {
      "enabled": true,
      "trusted_interfaces": ["GigabitEthernet0/24"]
    }
  }
}